# Copie a .env y ajuste. Formato: CENTINELA__<seccion>__<clave>=valor (sobreescribe config.yaml).

# Usuario que aparece en auditoría cuando el cliente MCP no envía uno.
CENTINELA_USUARIO=ejecutivo.demo
CENTINELA_LOG=INFO

# Ejemplos:
# CENTINELA__rutas__db=data/banco.db
# CENTINELA__modelos__agente__nombre=gemma4:26b-a4b-it-qat
# CENTINELA__modelos__vision__nombre=qwen3-vl:8b-instruct
# CENTINELA__seed__fecha_referencia=2026-11-20

# Sin telemetría ni descargas en tiempo de ejecución (se aplican también en el Makefile).
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
ANONYMIZED_TELEMETRY=False
DO_NOT_TRACK=1
ORT_DISABLE_TELEMETRY=1
