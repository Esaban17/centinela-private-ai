# Centinela en modo PAIS. Copie a .env (permisos 600): `cp .env.pais.example .env && chmod 600 .env`.
# El setup de despliegue/pais-deps lo arma solo. Nunca suba este archivo con valores reales.
CENTINELA_PROVEEDOR=pais
CENTINELA_USUARIO=ejecutivo.demo
CENTINELA_LOG=INFO

# Autenticación ante PAIS (elija una):
# a) usuario de servicio en Keycloak (realm lab, client pais con Direct access grants, grupo pais-users)
PAIS_KC_USUARIO=app-centinela
PAIS_KC_CLAVE=
# b) token estático (si está, no se usa Keycloak)
# PAIS_TOKEN=

# Clave del MCP demo-banco (la de mcp-demo/.env en pais-deps: MCP_API_KEY)
PAIS_MCP_API_KEY=

# Ajustes opcionales (formato CENTINELA__<seccion>__<clave>):
# CENTINELA__pais__url=https://pais.vcflab.local
# CENTINELA__pais__agente__id=7543e0a3-1cfe-4874-b85e-fd7c9ce3fe09
# CENTINELA__pais__stream=false              # si `make pais-probar` muestra que el streaming falla
# CENTINELA__orquestador__host=127.0.0.1      # en la Mac (fuera del contenedor)

HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
ANONYMIZED_TELEMETRY=False
DO_NOT_TRACK=1
ORT_DISABLE_TELEMETRY=1
